# Maintainer: DZL <dzl@example.com>
pkgname=dzl
pkgver=1.0.0
pkgrel=1
pkgdesc="Native GUI DayZ mod launcher (Bash DZL.sh port)"
arch=('any')
url="https://github.com/yourname/dzl"
license=('MIT')
depends=('python' 'pyside6' 'steam')
options=('!strip')

source=('dzl-1.0.0.tar.gz' 'dzl.desktop' 'dzl.png' 'README_Build.txt')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -dm755 "$pkgdir/usr/lib/dzl"
  cp -r "$srcdir/dzl-1.0.0/dzl" "$pkgdir/usr/lib/dzl/"
  find "$pkgdir/usr/lib/dzl" -name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null || true
  find "$pkgdir/usr/lib/dzl" -name '*.pyc' -delete 2>/dev/null || true

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/dzl" << 'LAUNCHER'
#!/bin/sh
export PYTHONPATH="/usr/lib/dzl${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -c "from dzl.main import main; import sys; sys.exit(main())" "$@"
LAUNCHER

  install -Dm644 "$srcdir/dzl.desktop" \
    "$pkgdir/usr/share/applications/dzl.desktop"

  install -Dm644 "$srcdir/dzl.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/dzl.png"

  install -Dm644 "$srcdir/dzl-1.0.0/LICENSE" \
    "$pkgdir/usr/share/licenses/dzl/LICENSE"

  for f in PKGBUILD README.md LICENSE dzl-deck-install.sh dzl-restore.sh Build_Install.txt; do
    install -Dm644 "$srcdir/dzl-1.0.0/$f" "$pkgdir/usr/share/dzl/build/$f"
  done
  install -Dm644 "$srcdir/dzl.desktop" "$pkgdir/usr/share/dzl/build/dzl.desktop"
  install -Dm644 "$srcdir/dzl.png" "$pkgdir/usr/share/dzl/build/dzl.png"
  install -Dm644 "$srcdir/README_Build.txt" "$pkgdir/usr/share/dzl/build/README_Build.txt"
}
